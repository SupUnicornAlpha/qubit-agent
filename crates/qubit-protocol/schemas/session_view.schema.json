{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionView",
  "type": "object",
  "required": [
    "agent_instance_id",
    "agent_spec_id",
    "created_at_ms",
    "event_seq",
    "execution_kind",
    "session_id",
    "status",
    "updated_at_ms",
    "workspace_id"
  ],
  "properties": {
    "agent_instance_id": {
      "type": "string"
    },
    "agent_spec_id": {
      "type": "string"
    },
    "created_at_ms": {
      "type": "integer",
      "format": "int64"
    },
    "event_seq": {
      "description": "Monotonic event seq for `events.subscribe(from_seq)`.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "execution_kind": {
      "$ref": "#/definitions/ExecutionKind"
    },
    "interaction_mode": {
      "description": "Control / interaction mode for this session (agent|plan|goal|ask|diagnose).",
      "default": "agent",
      "allOf": [
        {
          "$ref": "#/definitions/InteractionMode"
        }
      ]
    },
    "session_id": {
      "type": "string"
    },
    "status": {
      "$ref": "#/definitions/SessionStatus"
    },
    "updated_at_ms": {
      "type": "integer",
      "format": "int64"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "definitions": {
    "ExecutionKind": {
      "description": "Who may own user turns, who is invoke-only, who is event-driven.",
      "oneOf": [
        {
          "description": "User-facing hub; may also be invoked by other agents.",
          "type": "string",
          "enum": [
            "primary"
          ]
        },
        {
          "description": "Expert; invoke-only; isolated context window.",
          "type": "string",
          "enum": [
            "subagent"
          ]
        },
        {
          "description": "External trigger (MQ / A2A / webhook / domain event).",
          "type": "string",
          "enum": [
            "reactor"
          ]
        }
      ]
    },
    "InteractionMode": {
      "description": "How this Session/Turn is allowed to act.\n\nOrthogonal to [`crate::ExecutionKind`]: - ExecutionKind = who may talk / be invoked / be triggered - InteractionMode = what the loop may do this session",
      "oneOf": [
        {
          "description": "Full tool surface (default). Maps to Cursor \"Agent\".",
          "type": "string",
          "enum": [
            "agent"
          ]
        },
        {
          "description": "Only `update_plan` (+ read-only L0 helpers). No side-effect tools.",
          "type": "string",
          "enum": [
            "plan"
          ]
        },
        {
          "description": "Must maintain goal + steps; delivery gated on plan completion.",
          "type": "string",
          "enum": [
            "goal"
          ]
        },
        {
          "description": "Q&A / analysis text; tools denied or read-only surface.",
          "type": "string",
          "enum": [
            "ask"
          ]
        },
        {
          "description": "Root-cause / failure attribution: diagnostics tools + ledger replay. (Renamed from Cursor-ish \"Debug\" — wire name is `diagnose`.)",
          "type": "string",
          "enum": [
            "diagnose"
          ]
        }
      ]
    },
    "SessionStatus": {
      "type": "string",
      "enum": [
        "active",
        "archived",
        "degraded"
      ]
    }
  }
}