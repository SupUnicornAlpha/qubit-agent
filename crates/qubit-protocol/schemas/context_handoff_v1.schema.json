{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ContextHandoffV1",
  "description": "Structured handoff returned by subagent / reactor / invoked primary.",
  "type": "object",
  "required": [
    "goal",
    "version"
  ],
  "properties": {
    "asof": {
      "type": [
        "string",
        "null"
      ]
    },
    "claims": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/WorkingClaim"
      }
    },
    "debate": {
      "anyOf": [
        {
          "$ref": "#/definitions/WorkingDebate"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "anyOf": [
        {
          "$ref": "#/definitions/HandoffEvidence"
        },
        {
          "type": "null"
        }
      ]
    },
    "finance_refs": {
      "default": {
        "composition_ids": [],
        "evaluation_ids": [],
        "factor_ids": [],
        "symbols": []
      },
      "allOf": [
        {
          "$ref": "#/definitions/WorkingMemoryFinanceRefs"
        }
      ]
    },
    "goal": {
      "type": "string"
    },
    "narrative": {
      "type": [
        "string",
        "null"
      ]
    },
    "symbols": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    }
  },
  "definitions": {
    "ClaimStance": {
      "type": "string",
      "enum": [
        "bull",
        "bear",
        "neutral",
        "unknown"
      ]
    },
    "ClaimStatus": {
      "type": "string",
      "enum": [
        "open",
        "supported",
        "refuted",
        "stale"
      ]
    },
    "HandoffEvidence": {
      "type": "object",
      "required": [
        "kind",
        "verified"
      ],
      "properties": {
        "detail": true,
        "kind": {
          "$ref": "#/definitions/HandoffEvidenceKind"
        },
        "verified": {
          "type": "boolean"
        }
      }
    },
    "HandoffEvidenceKind": {
      "type": "string",
      "enum": [
        "market_data",
        "news",
        "analysis",
        "factor",
        "none"
      ]
    },
    "WorkingClaim": {
      "type": "object",
      "required": [
        "id",
        "status",
        "text"
      ],
      "properties": {
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "evidence_refs": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "stance": {
          "anyOf": [
            {
              "$ref": "#/definitions/ClaimStance"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/definitions/ClaimStatus"
        },
        "symbols": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "text": {
          "type": "string"
        }
      }
    },
    "WorkingDebate": {
      "type": "object",
      "properties": {
        "bear_points": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bull_points": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resolution": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "WorkingMemoryFinanceRefs": {
      "type": "object",
      "properties": {
        "composition_ids": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evaluation_ids": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "factor_ids": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "symbols": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}