{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkingMemory",
  "type": "object",
  "required": [
    "updated_at",
    "version"
  ],
  "properties": {
    "debate": {
      "anyOf": [
        {
          "$ref": "#/definitions/WorkingDebate"
        },
        {
          "type": "null"
        }
      ]
    },
    "decisions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "finance_refs": {
      "default": {
        "composition_ids": [],
        "evaluation_ids": [],
        "factor_ids": [],
        "symbols": []
      },
      "allOf": [
        {
          "$ref": "#/definitions/WorkingMemoryFinanceRefs"
        }
      ]
    },
    "hypotheses": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/WorkingClaim"
      }
    },
    "open_questions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trail_stub": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/TrailStub"
      }
    },
    "updated_at": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    }
  },
  "definitions": {
    "ClaimStance": {
      "type": "string",
      "enum": [
        "bull",
        "bear",
        "neutral",
        "unknown"
      ]
    },
    "ClaimStatus": {
      "type": "string",
      "enum": [
        "open",
        "supported",
        "refuted",
        "stale"
      ]
    },
    "TrailStub": {
      "type": "object",
      "required": [
        "ok",
        "one_liner",
        "step"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "one_liner": {
          "type": "string"
        },
        "step": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "tool": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "WorkingClaim": {
      "type": "object",
      "required": [
        "id",
        "status",
        "text"
      ],
      "properties": {
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "evidence_refs": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "stance": {
          "anyOf": [
            {
              "$ref": "#/definitions/ClaimStance"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/definitions/ClaimStatus"
        },
        "symbols": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "text": {
          "type": "string"
        }
      }
    },
    "WorkingDebate": {
      "type": "object",
      "properties": {
        "bear_points": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bull_points": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resolution": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "WorkingMemoryFinanceRefs": {
      "type": "object",
      "properties": {
        "composition_ids": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evaluation_ids": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "factor_ids": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "symbols": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}