{
  "format": "qubit-ui-theme",
  "manifestVersion": 1,
  "id": "aurora-terminal",
  "name": "Aurora Terminal",
  "version": "1.0.0",
  "colorScheme": "dark",
  "tokens": {
    "--qb-bg-root": "#08111a",
    "--qb-bg-root-top": "#0b1824",
    "--qb-body-fg": "#d8f3ef",
    "--qb-main-input-bg": "#0d1d29",
    "--qb-main-input-border": "#245260",
    "--qb-main-input-fg": "#d8f3ef",
    "--qb-main-card-bg": "#0d1d29",
    "--qb-main-card-border": "#245260",
    "--qb-main-panel-bg": "#08111a",
    "--qb-main-meta": "#83a8ae",
    "--qb-blue": "#56d4c5",
    "--qb-blue-deep": "#23b3a2",
    "--qb-focus-ring": "rgba(86, 212, 197, 0.5)",
    "--qb-separator": "#245260"
  },
  "quantTokens": {
    "--qb-bg-surface": "#08111a",
    "--qb-bg-elevated": "#0d1d29",
    "--qb-bg-elevated-strong": "#142a37",
    "--qb-bg-hero": "linear-gradient(135deg, #102b36, #08111a)",
    "--qb-border-subtle": "#1c4553",
    "--qb-border-strong": "#2c6270",
    "--qb-text-muted": "#83a8ae",
    "--qb-text-strong": "#d8f3ef",
    "--qb-success": "#62d69d",
    "--qb-warn": "#f3bd65",
    "--qb-error": "#fa7979",
    "--qb-info": "#56d4c5",
    "--qb-quant-accent-1": "#78a8ff",
    "--qb-quant-accent-2": "#56d4c5",
    "--qb-quant-accent-3": "#f3bd65",
    "--qb-quant-accent-4": "#c59cff",
    "--qb-quant-accent-5": "#62d69d",
    "--qb-quant-danger": "#fa7979",
    "--qb-quant-hero-glow": "radial-gradient(75% 100% at 0 0, rgba(86, 212, 197, 0.14), transparent 62%)",
    "--qb-quant-card-shadow": "0 8px 22px rgba(0, 0, 0, 0.24)"
  },
  "css": "html[data-qb-style=\"aurora-terminal\"] [data-qb-quant-shell] .qb-quant-hero-card { border-radius: 12px; }\nhtml[data-qb-style=\"aurora-terminal\"] [data-qb-quant-shell] .qb-quant-tab--active { box-shadow: 0 0 18px rgba(86, 212, 197, 0.28); }"
}
